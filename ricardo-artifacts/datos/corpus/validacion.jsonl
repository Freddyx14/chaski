{"audio": "datos/crudo/p15/p15_C_004.wav", "texto": "Allinllaña kaspapas,ama hampita millpuycho", "persona": "p15"}
{"audio": "datos/crudo/p18/p18_B_068.wav", "texto": "Ususiyqa iskay punchawmanta wischuchkan.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_001.wav", "texto": "Huk pastillata upyay, sapa pusaq horaspi", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_009.wav", "texto": "Huk killapi kutimuy.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_017.wav", "texto": "Imapas alergiayuqchu kanki?", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_025.wav", "texto": "Kimsa punchawpi chayamunqa.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_E_083.wav", "texto": "Ñuqallaymi, doctor", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_E_091.wav", "texto": "Yaykuykamuy taytáy", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_E_099.wav", "texto": "Mamáy, ¿imachamanmi hamuchkanki?", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_E_107.wav", "texto": "Uyariykim, mamáy", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_E_115.wav", "texto": "Juezpa uyariwanantam munani", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_E_123.wav", "texto": "Primer Juzgadotam maskachkani", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_E_131.wav", "texto": "¿Runasimita yachankichu, doctora?", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_E_139.wav", "texto": "¿Manachu kaqmanta rimariwaq?", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_E_147.wav", "texto": "¡Yanapaway!", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_E_155.wav", "texto": "¿Ima horasta fiscal chayamunqa?", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_E_163.wav", "texto": "Pampachayuway qhiparikusqaymanta", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_E_171.wav", "texto": "Paqarinkama, taytáy", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_M_029.wav", "texto": "Omeprazolta yarqayniyuq upyay.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_M_037.wav", "texto": "Vitamina C - ta upyay.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_M_045.wav", "texto": "Chawpi tableta.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_M_053.wav", "texto": "Qam diabetesniyuq kanki.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_N_061.wav", "texto": "Pastillata upyay, sapa chunka iskayniyuq horaspim.", "persona": "p18"}
{"audio": "datos/crudo/p19/p19_C_006.wav", "texto": "Qhawachikunaykiqa killachawmi", "persona": "p19"}
{"audio": "datos/crudo/p20/p20_E_081.wav", "texto": "¿Imaynallam kachkanki, taytáy?", "persona": "p20"}
{"audio": "datos/crudo/p24/p24_C_010.wav", "texto": "Yahuar kaptin jamunki apurayman", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_C_018.wav", "texto": "Jaica huatayuc kanki", "persona": "p24"}
