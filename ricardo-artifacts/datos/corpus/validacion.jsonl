{"audio": "datos/crudo/p17/p17_C_012.wav", "texto": "mana wawa kuyuritinqa hamunki", "persona": "p17"}
{"audio": "datos/crudo/p17/p17_C_023.wav", "texto": "partillata chay pastillata tumanki", "persona": "p17"}
{"audio": "datos/crudo/p17/p17_M_031.wav", "texto": "tomanki acido folico", "persona": "p17"}
{"audio": "datos/crudo/p17/p17_M_039.wav", "texto": "tomanki huk tabletata", "persona": "p17"}
