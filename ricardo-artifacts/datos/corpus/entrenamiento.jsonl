{"audio": "datos/crudo/p24/p24_E_109.wav", "texto": "Uyarisqaykichik", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_110.wav", "texto": "Denuncia churaqmi hamuchkani", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_112.wav", "texto": "Tapukuqmi hamuchkani", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_113.wav", "texto": "Juezwanmi rimayta munani", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_114.wav", "texto": "Fiscalwanmi rimayta munani", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_115.wav", "texto": "Juezpa uyariwanantam munani", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_116.wav", "texto": "Fiscalpa uyariwanantam munani", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_117.wav", "texto": "Fiscalwanmi rimanay kachkan", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_118.wav", "texto": "¿Imatan suyarichkanki, mamáy?", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_120.wav", "texto": "¿Allichu yanapawankikumanchu, taytáy?", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_121.wav", "texto": "Mamáy, ¿yanapawankikumanchu?", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_122.wav", "texto": "Demunatam maskachkani", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_123.wav", "texto": "Primer Juzgadotam maskachkani", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_124.wav", "texto": "Wawata suyarichkani, jefelláy", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_125.wav", "texto": "Abogadoytam suyarichkani", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_126.wav", "texto": "Runasimita rimani, taytáy", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_128.wav", "texto": "Manam castellanuta rimanichu", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_129.wav", "texto": "¿Runasimita rimankichu, doctor?", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_130.wav", "texto": "Arí, runasimita rimani", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_131.wav", "texto": "¿Runasimita yachankichu, doctora?", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_132.wav", "texto": "Arí, runasimita yachani", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_133.wav", "texto": "Manam runasimita yachanichu", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_134.wav", "texto": "¿Runasimitachu utaq castellanusimitachu rimayta munanki?", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_136.wav", "texto": "¿Pitaq kaypi castellanota riman?", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_137.wav", "texto": "Allichu, allinllamanta rimaway", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_138.wav", "texto": "¿Allinllamanta rimaykuwankimanchu?", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_139.wav", "texto": "¿Manachu kaqmanta rimariwaq?", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_140.wav", "texto": "¿Yapa chayta rimaykuwankimanchu?", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_141.wav", "texto": "Allichu, huktawan niway", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_142.wav", "texto": "Hawkalla kakuy, mamáy", "persona": "p24"}
