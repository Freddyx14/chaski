{"audio": "datos/crudo/p15/p15_C_012.wav", "texto": "Wawayki mana kuyuqtinqa hamuy", "persona": "p15"}
{"audio": "datos/crudo/p15/p15_C_016.wav", "texto": "Ima jampita upyanki", "persona": "p15"}
{"audio": "datos/crudo/p17/p17_C_001.wav", "texto": "Sapa pusaq horamanta huk pastillata upyana", "persona": "p17"}
{"audio": "datos/crudo/p18/p18_B_064.wav", "texto": "Umaymi nanchkan qayna punchawmanta .", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_B_065.wav", "texto": "Wiksaymi nanachkan kimsa punchawmanta.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_B_066.wav", "texto": "Paracetamolta upyachkani.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_B_067.wav", "texto": "Churiyqa rupayniyuqmi kachkan paqarin tutamanta.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_B_069.wav", "texto": "Manam entiendirqanichu, yapamanta niway, ama hina  kaspa.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_B_070.wav", "texto": "Pastillata qunqarquspa, imatam ruwa saq?", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_B_071.wav", "texto": "Haykap punchawmi hamunay control niypaq?", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_B_072.wav", "texto": "Mana ima hampipipas alergiyachu kani.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_B_073.wav", "texto": "Sapa  pusaq horapi huk pastillata upyanaymi, qanchis punchawpaq.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_B_074.wav", "texto": "Kunanqa allinlam tarikuni.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_B_075.wav", "texto": "Añay señorita.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_002.wav", "texto": "Mikuyta tukuruspa, pastillata upyay", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_003.wav", "texto": "Yakuwan upyay, ama tewan upyaychu.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_004.wav", "texto": "Allinña kachkaspapas, ama pastillata saqiychu.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_005.wav", "texto": "Qanchis punchawmi hampikuy.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_006.wav", "texto": "Lunes punchawmi controlniykipa hamunki.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_007.wav", "texto": "Yarqayman hamuy.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_008.wav", "texto": "Carnéykita apamuy.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_010.wav", "texto": "Yawar chayamuptin , usqhaylla hamuy.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_011.wav", "texto": "Hatun rupay kaptin hamuy.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_012.wav", "texto": "Wawa mana kuyuriptin , hamuy.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_013.wav", "texto": "Haykap pachamanta nanachkan?", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_014.wav", "texto": "Maypim nanasunki?", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_015.wav", "texto": "Rupayniyuqchu kanki?", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_016.wav", "texto": "Ima pastillatapas upyachkankichu?", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_018.wav", "texto": "Hayka watayuq kanki?", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_019.wav", "texto": "Presionniykita tupusayki.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_020.wav", "texto": "Samarikuy sinchita, ama hina kaspa.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_021.wav", "texto": "Kimsachunka isqunniyuq fiebre.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_022.wav", "texto": "Achka yakuta upyay.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_023.wav", "texto": "Chawpi pastilla, manam huntasqachu.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_C_024.wav", "texto": "Iskay kuti punchawpi, tutamanta chaymanta tuta.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_E_076.wav", "texto": "¿Allinllanchu, mamáy?", "persona": "p18"}
