{"audio": "datos/crudo/p24/p24_E_106.wav", "texto": "¿Yanapayta atiymankuchu?", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_107.wav", "texto": "Uyariykim, mamáy", "persona": "p24"}
