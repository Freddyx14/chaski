{"audio": "datos/crudo/p24/p24_E_146.wav", "texto": "Ama llakikuychu", "persona": "p24"}
{"audio": "datos/crudo/p24/p24_E_147.wav", "texto": "¡Yanapaway!", "persona": "p24"}
