{"audio": "datos/crudo/p18/p18_B_068.wav", "texto": "Ususiyqa iskay punchawmanta wischuchkan.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_B_069.wav", "texto": "Manam entiendirqanichu, yapamanta niway, ama hina  kaspa.", "persona": "p18"}
{"audio": "datos/crudo/p18/p18_B_070.wav", "texto": "Pastillata qunqarquspa, imatam ruwa saq?", "persona": "p18"}
