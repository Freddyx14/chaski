{"persona": "p24", "bloque": "B", "numero": 74, "audio": "datos/crudo/p24/p24_B_074.wav", "transcripcion": "", "castellano": "Ya me siento mejor", "segundos": 4.0, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "B", "numero": 75, "audio": "datos/crudo/p24/p24_B_075.wav", "transcripcion": "Añay sipass", "castellano": "Gracias, señorita", "segundos": 3.0, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 76, "audio": "datos/crudo/p24/p24_E_076.wav", "transcripcion": "¿Allinllanchu, mamáy?", "castellano": "¿Está bien, señora?", "segundos": 2.7, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 77, "audio": "datos/crudo/p24/p24_E_077.wav", "transcripcion": "¡Allinllanmi, taytáy!", "castellano": "¡Estoy bien, señor!", "segundos": 4.4, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 78, "audio": "datos/crudo/p24/p24_E_078.wav", "transcripcion": "Taytáy, ¿allillanchu?", "castellano": "Señor, ¿cómo está?", "segundos": 2.9, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 79, "audio": "datos/crudo/p24/p24_E_079.wav", "transcripcion": "Mamáy, allillanmi", "castellano": "Señora, estoy bien", "segundos": 4.7, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 80, "audio": "datos/crudo/p24/p24_E_080.wav", "transcripcion": "¿Imaynallam kachkanki, taytáy?", "castellano": "¿Cómo está, señor?", "segundos": 6.9, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
