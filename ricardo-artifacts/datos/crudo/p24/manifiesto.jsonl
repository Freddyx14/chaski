{"persona": "p24", "bloque": "B", "numero": 72, "audio": "datos/crudo/p24/p24_B_072.wav", "transcripcion": "", "castellano": "No soy alérgico a ningún remedio", "segundos": 5.1, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
