{"persona": "p24", "bloque": "E", "numero": 141, "audio": "datos/crudo/p24/p24_E_141.wav", "transcripcion": "Allichu, huktawan niway", "castellano": "Por favor, repita", "segundos": 5.2, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 142, "audio": "datos/crudo/p24/p24_E_142.wav", "transcripcion": "Hawkalla kakuy, mamáy", "castellano": "Tranquilícese, señora", "segundos": 4.7, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 143, "audio": "datos/crudo/p24/p24_E_143.wav", "transcripcion": "Hawkayay, taytáy", "castellano": "Cálmese, señor", "segundos": 3.7, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 144, "audio": "datos/crudo/p24/p24_E_144.wav", "transcripcion": "Llakikuyñiykita willawanki", "castellano": "Cuénteme lo que le aflige", "segundos": 5.2, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 145, "audio": "datos/crudo/p24/p24_E_145.wav", "transcripcion": "Lliumi allin kanqa", "castellano": "Todo va a estar bien", "segundos": 3.8, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 146, "audio": "datos/crudo/p24/p24_E_146.wav", "transcripcion": "Ama llakikuychu", "castellano": "No se preocupe", "segundos": 5.1, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 147, "audio": "datos/crudo/p24/p24_E_147.wav", "transcripcion": "¡Yanapaway!", "castellano": "¡Ayúdeme!", "segundos": 2.9, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 148, "audio": "datos/crudo/p24/p24_E_148.wav", "transcripcion": "Yanapasqayki", "castellano": "Le ayudaré", "segundos": 3.2, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 149, "audio": "datos/crudo/p24/p24_E_149.wav", "transcripcion": "Yanapasqaykikum", "castellano": "Le vamos a ayudar", "segundos": 3.2, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 150, "audio": "datos/crudo/p24/p24_E_150.wav", "transcripcion": "Uyariy", "castellano": "Escuche", "segundos": 2.8, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 151, "audio": "datos/crudo/p24/p24_E_151.wav", "transcripcion": "Uyariykullaway", "castellano": "Escúcheme, por favor", "segundos": 3.6, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 152, "audio": "datos/crudo/p24/p24_E_152.wav", "transcripcion": "Ama hina kaychu, taytáy", "castellano": "Por favor, señor", "segundos": 4.7, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 153, "audio": "datos/crudo/p24/p24_E_153.wav", "transcripcion": "¡Ima allinmi hamuranki!", "castellano": "¡Qué bueno que ha venido!", "segundos": 4.8, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 154, "audio": "datos/crudo/p24/p24_E_154.wav", "transcripcion": "¿Ima horasta comisario chayamunqa?", "castellano": "¿A qué hora llega el comisario?", "segundos": 7.1, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 155, "audio": "datos/crudo/p24/p24_E_155.wav", "transcripcion": "¿Ima horasta fiscal chayamunqa?", "castellano": "¿A qué hora llega el fiscal?", "segundos": 4.8, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 156, "audio": "datos/crudo/p24/p24_E_156.wav", "transcripcion": "Kasqanpacha", "castellano": "Inmediatamente", "segundos": 3.0, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 157, "audio": "datos/crudo/p24/p24_E_157.wav", "transcripcion": "Kunanpacha", "castellano": "En este momento", "segundos": 3.2, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 158, "audio": "datos/crudo/p24/p24_E_158.wav", "transcripcion": "Manam yanapayta atinichu, mamáy", "castellano": "No puedo ayudarle, señora", "segundos": 5.1, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 159, "audio": "datos/crudo/p24/p24_E_159.wav", "transcripcion": "Anchata llakikuni, taytáy", "castellano": "Lo lamento mucho, señor", "segundos": 4.3, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 160, "audio": "datos/crudo/p24/p24_E_160.wav", "transcripcion": "Anchata llakipayki", "castellano": "Lo lamento mucho", "segundos": 3.6, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 161, "audio": "datos/crudo/p24/p24_E_161.wav", "transcripcion": "Pampachaway", "castellano": "Disculpe", "segundos": 3.2, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 162, "audio": "datos/crudo/p24/p24_E_162.wav", "transcripcion": "Pampachaykuway", "castellano": "Perdóneme", "segundos": 3.9, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 163, "audio": "datos/crudo/p24/p24_E_163.wav", "transcripcion": "Pampachayuway qhiparikusqaymanta", "castellano": "Perdón por llegar tarde", "segundos": 5.3, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 164, "audio": "datos/crudo/p24/p24_E_164.wav", "transcripcion": "Pampachaway, kunanqa manam riyta atinichu", "castellano": "Perdóneme, pero no puedo ir ahora", "segundos": 8.3, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 165, "audio": "datos/crudo/p24/p24_E_165.wav", "transcripcion": "Kunanqa manam paywan rimayta atinkichu", "castellano": "No puede hablar con él ahora", "segundos": 7.9, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 166, "audio": "datos/crudo/p24/p24_E_166.wav", "transcripcion": "Yusulpayki", "castellano": "¡Gracias!", "segundos": 3.0, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 167, "audio": "datos/crudo/p24/p24_E_167.wav", "transcripcion": "Yanaparwanki", "castellano": "¡Me ha ayudado!", "segundos": 3.4, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 168, "audio": "datos/crudo/p24/p24_E_168.wav", "transcripcion": "Yusulpayki yanapawasqaykimanta", "castellano": "Gracias por su ayuda", "segundos": 6.5, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 169, "audio": "datos/crudo/p24/p24_E_169.wav", "transcripcion": "Imamanta", "castellano": "No hay de qué", "segundos": 4.9, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 170, "audio": "datos/crudo/p24/p24_E_170.wav", "transcripcion": "Mana imamantapas", "castellano": "No tiene por qué", "segundos": 3.3, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 171, "audio": "datos/crudo/p24/p24_E_171.wav", "transcripcion": "Paqarinkama, taytáy", "castellano": "Nos vemos mañana, señor", "segundos": 4.7, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 172, "audio": "datos/crudo/p24/p24_E_172.wav", "transcripcion": "Huk punchawkama, señora", "castellano": "Hasta otro día, señora", "segundos": 4.1, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 173, "audio": "datos/crudo/p24/p24_E_173.wav", "transcripcion": "Anchata agradisiyki, papay", "castellano": "¡Muchas gracias, señor!", "segundos": 5.1, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 174, "audio": "datos/crudo/p24/p24_E_174.wav", "transcripcion": "Allicha, huk ratucha suyay", "castellano": "Espere un momento, por favor", "segundos": 5.7, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
{"persona": "p24", "bloque": "E", "numero": 175, "audio": "datos/crudo/p24/p24_E_175.wav", "transcripcion": "Allicha, huk ratucha suyaychik", "castellano": "Esperen un momento, por favor", "segundos": 6.2, "consentimiento": true, "origen": "", "inicio": 0.0, "fin": 0.0}
