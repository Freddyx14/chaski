        <mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#C8C5B8;" edge="1" parent="1" source="n26" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell>
