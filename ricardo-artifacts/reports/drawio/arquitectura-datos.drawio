<mxfile host="app.diagrams.net" type="device">
  <diagram id="Datos" name="Datos">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0" background="#F4F3EE">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="De la voz de la familia al número del pitch" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="n3" value="Arquitectura de datos. La regla que sostiene todo: la voz de prueba nunca entra al entrenamiento." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4E4D45;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="29" as="geometry"/></mxCell>
        <mxCell id="n4" value="1 · Recolección" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="300" height="31" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Cuadernillos&lt;/b&gt;&lt;br&gt;&lt;br&gt;175 frases numeradas&lt;br&gt;seis bloques: A B C M N E&lt;br&gt;Se escribe primero, se graba después" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="40" y="118" width="220" height="108" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;Formulario (Freddy)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Vercel · la familia sube audio&lt;br&gt;y cómo se escribe&lt;br&gt;No lo tocamos desde aquí" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B9476;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="290" y="118" width="220" height="108" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;/corregir (Ricardo)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Transcribe, yo corrijo el escrito&lt;br&gt;Parte y une si cortó mal&lt;br&gt;Verifica audio contra texto" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="540" y="118" width="230" height="108" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;manifiesto.jsonl&lt;/b&gt;&lt;br&gt;&lt;br&gt;persona · bloque · numero&lt;br&gt;audio · transcripcion · castellano&lt;br&gt;segundos · consentimiento" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="800" y="118" width="240" height="108" as="geometry"/></mxCell>
        <mxCell id="n12" value="2 · Partición POR HABLANTE, nunca por frase" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="520" height="31" as="geometry"/></mxCell>
        <mxCell id="n13" value="&lt;b&gt;entrenamiento&lt;/b&gt;&lt;br&gt;&lt;br&gt;3 personas · ~22 min&lt;br&gt;Ajusta el modelo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="40" y="266" width="230" height="76" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b&gt;validación&lt;/b&gt;&lt;br&gt;&lt;br&gt;12 % del entrenamiento&lt;br&gt;Elige hiperparámetros" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="300" y="266" width="220" height="76" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;b&gt;prueba · una persona entera&lt;/b&gt;&lt;br&gt;&lt;br&gt;Voz que el modelo NUNCA escuchó&lt;br&gt;Se toca una sola vez, al final" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="550" y="266" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="n16" value="3 · Tres pasos, tres números — se reportan los tres salga lo que salga" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="368" width="700" height="31" as="geometry"/></mxCell>
        <mxCell id="n17" value="&lt;b&gt;0 · El modelo tal cual&lt;/b&gt;&lt;br&gt;&lt;br&gt;Línea base. Sin tocar nada." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="40" y="394" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="n18" value="&lt;b&gt;1 · + vocabulario de la posta&lt;/b&gt;&lt;br&gt;&lt;br&gt;Glosario y préstamos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="320" y="394" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="n19" value="&lt;b&gt;2 · + ajuste fino con las voces&lt;/b&gt;&lt;br&gt;&lt;br&gt;ASR 30 épocas: 14 min&lt;br&gt;Voz 50 épocas: 20 min&lt;br&gt;medido en la A10G" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="600" y="394" width="250" height="92" as="geometry"/></mxCell>
        <mxCell id="n22" value="4 · Cada cosa se mide contra una verdad distinta" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="494" width="700" height="31" as="geometry"/></mxCell>
        <mxCell id="n23" value="Hasta el 24-oct la auditoría no tenía ninguna: solo se comparaba con la de Freddy, y eso no prueba nada si las dos se equivocan igual." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#4E4D45;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="514" width="1000" height="28" as="geometry"/></mxCell>
        <mxCell id="n24" value="&lt;b&gt;medir_asr.py — entender&lt;/b&gt;&lt;br&gt;&lt;br&gt;Verdad: el escrito corregido en /corregir&lt;br&gt;WER y CER · corte por hablante&lt;br&gt;Aparte: préstamos y números" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="40" y="542" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="n25" value="&lt;b&gt;medir_traduccion.py — traducir&lt;/b&gt;&lt;br&gt;&lt;br&gt;Verdad: 100 pares verificados, fuera del train&lt;br&gt;chrF++, no BLEU: el quechua aglutina&lt;br&gt;Base sin ajustar: chrF++ 42.31" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="370" y="542" width="320" height="108" as="geometry"/></mxCell>
        <mxCell id="n26" value="&lt;b&gt;medir_guarda.py — no dejar pasar errores&lt;/b&gt;&lt;br&gt;&lt;br&gt;Verdad: se inyecta un error clínico a propósito&lt;br&gt;Dosis cambiada · negación borrada · condición&lt;br&gt;0/6 falsos bloqueos · 3/6 FUGAS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="720" y="542" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="n27" value="&lt;b&gt;medir_auditoria.py — estabilidad&lt;/b&gt;&lt;br&gt;&lt;br&gt;La misma frase, varias corridas&lt;br&gt;Bloqueo · estabilidad · mediana&lt;br&gt;La de 4 llamadas da: sí, no, sí" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1080" y="542" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="n28" value="&lt;b&gt;reports/*.json&lt;/b&gt;&lt;br&gt;&lt;br&gt;asr · lid · traduccion · guarda · auditoria&lt;br&gt;Un archivo por número" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="370" y="676" width="320" height="76" as="geometry"/></mxCell>
        <mxCell id="n29" value="&lt;b&gt;La página y el pitch&lt;/b&gt;&lt;br&gt;&lt;br&gt;Leen esos JSON y nada más.&lt;br&gt;Si un número sale malo, se muestra igual." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="720" y="676" width="330" height="76" as="geometry"/></mxCell>
        <mxCell id="n35" value="&lt;b&gt;Qué se ajusta y qué no&lt;/b&gt;&lt;br&gt;&lt;br&gt;Se ajustan los dos modelos de Meta: omniASR (entender chanka) y mms-tts-quy (hablar chanka).&lt;br&gt;mms-lid ya acierta 6/6 y se deja quieto. Cartesia y Claude no se ajustan: se usan como vienen.&lt;br&gt;&lt;br&gt;Y son dos ajustes distintos: entender quiere MUCHAS voces; hablar quiere UNA sola voz consistente,&lt;br&gt;la de la mamá de Freddy. Por eso todos graban, pero la voz de Chaski sale de una sola persona." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4C2B6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="40" y="786" width="1340" height="126" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell>
