<mxfile host="app.diagrams.net" type="device">
  <diagram id="Data" name="Data">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0" background="#F4F3EE">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="From a family's voice to a number we can defend" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="n3" value="Data architecture. The one rule everything rests on: the test speaker never enters training." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4E4D45;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="900" height="29" as="geometry"/></mxCell>
        <mxCell id="n4" value="1 · Collection" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="300" height="31" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Printed booklets&lt;/b&gt;&lt;br&gt;&lt;br&gt;175 numbered sentences&lt;br&gt;six blocks: A B C M N E&lt;br&gt;Written first, recorded after" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="40" y="118" width="220" height="108" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;Web form (Freddy)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Vercel · families upload audio&lt;br&gt;and how it is spelled&lt;br&gt;Not touched from this side" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B9476;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="290" y="118" width="220" height="108" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;/corregir (Ricardo)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Transcribes, a human fixes the text&lt;br&gt;Splits and joins bad cuts&lt;br&gt;Checks audio against text" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="540" y="118" width="230" height="108" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;manifiesto.jsonl&lt;/b&gt;&lt;br&gt;&lt;br&gt;speaker · block · number&lt;br&gt;audio · transcript · Spanish&lt;br&gt;seconds · consent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="800" y="118" width="240" height="96" as="geometry"/></mxCell>
        <mxCell id="n12" value="2 · Split BY SPEAKER, never by sentence" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="520" height="31" as="geometry"/></mxCell>
        <mxCell id="n13" value="&lt;b&gt;train&lt;/b&gt;&lt;br&gt;&lt;br&gt;3 speakers · ~22 min&lt;br&gt;Fits the adapter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="40" y="266" width="230" height="76" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b&gt;validation&lt;/b&gt;&lt;br&gt;&lt;br&gt;12 % of train&lt;br&gt;Picks hyperparameters" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="300" y="266" width="220" height="76" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;b&gt;test · one whole speaker&lt;/b&gt;&lt;br&gt;&lt;br&gt;A voice the model NEVER heard&lt;br&gt;Touched once, at the end" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="550" y="266" width="300" height="76" as="geometry"/></mxCell>
        <mxCell id="n16" value="3 · Three steps, three numbers — all three reported, whatever they say" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="368" width="700" height="31" as="geometry"/></mxCell>
        <mxCell id="n17" value="&lt;b&gt;0 · The model as shipped&lt;/b&gt;&lt;br&gt;&lt;br&gt;Baseline. Nothing touched." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="40" y="394" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="n18" value="&lt;b&gt;1 · + clinic vocabulary&lt;/b&gt;&lt;br&gt;&lt;br&gt;Glossary and loanwords" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="320" y="394" width="250" height="70" as="geometry"/></mxCell>
        <mxCell id="n19" value="&lt;b&gt;2 · + fine-tuning on the voices&lt;/b&gt;&lt;br&gt;&lt;br&gt;ASR 30 epochs: 14 min&lt;br&gt;TTS 50 epochs: 20 min&lt;br&gt;measured on the A10G" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="600" y="394" width="250" height="92" as="geometry"/></mxCell>
        <mxCell id="n22" value="4 · Each thing is measured against its own ground truth" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="494" width="700" height="31" as="geometry"/></mxCell>
        <mxCell id="n23" value="Until Oct 24 the audit had none: it only compared against Freddy's, which proves nothing if both are wrong the same way." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#4E4D45;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="514" width="1000" height="28" as="geometry"/></mxCell>
        <mxCell id="n24" value="&lt;b&gt;medir_asr.py — understanding&lt;/b&gt;&lt;br&gt;&lt;br&gt;Truth: the text corrected in /corregir&lt;br&gt;WER and CER · speaker-held-out&lt;br&gt;Scored apart: loanwords and numbers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="40" y="542" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="n25" value="&lt;b&gt;medir_traduccion.py — translation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Truth: 62 pairs the families wrote on hackathon day&lt;br&gt;chrF++, not BLEU: Quechua is agglutinative&lt;br&gt;Sonnet 5 44.6 · NLLB-1.3B 34.7 · 600M 28.6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="370" y="542" width="320" height="108" as="geometry"/></mxCell>
        <mxCell id="n26" value="&lt;b&gt;medir_guarda.py — catching errors&lt;/b&gt;&lt;br&gt;&lt;br&gt;Truth: a clinical error is injected on purpose&lt;br&gt;Changed dose · dropped negation · condition&lt;br&gt;183/184 caught · 100 % of the critical ones" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="720" y="542" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="n27" value="&lt;b&gt;medir_auditoria.py — stability&lt;/b&gt;&lt;br&gt;&lt;br&gt;Same sentence, several runs&lt;br&gt;Blocked · stability · median&lt;br&gt;The 4-call variant gives: yes, no, yes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1080" y="542" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="n28" value="&lt;b&gt;reports/*.json&lt;/b&gt;&lt;br&gt;&lt;br&gt;asr · lid · translation · guard · audit&lt;br&gt;One file per number" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="370" y="676" width="320" height="76" as="geometry"/></mxCell>
        <mxCell id="n29" value="&lt;b&gt;The page and the pitch&lt;/b&gt;&lt;br&gt;&lt;br&gt;Read those JSON files and nothing else.&lt;br&gt;A bad number is shown anyway." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="720" y="676" width="330" height="76" as="geometry"/></mxCell>
        <mxCell id="n35" value="&lt;b&gt;What we fine-tune, and what we leave alone&lt;/b&gt;&lt;br&gt;&lt;br&gt;Two Meta models are fine-tuned: MMS-1B-all (understanding Chanka) and mms-tts-quy (speaking it).&lt;br&gt;mms-lid is used as shipped. Cartesia and Claude are not fine-tuned at all.&lt;br&gt;&lt;br&gt;They are two different jobs: understanding wants MANY voices; speaking wants ONE consistent voice,&lt;br&gt;Freddy’s mother. That is why everyone records, but Chaski speaks with a single person’s voice." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4C2B6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="40" y="786" width="1340" height="126" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#C8C5B8;" edge="1" parent="1" source="n24" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#C8C5B8;" edge="1" parent="1" source="n25" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#C8C5B8;" edge="1" parent="1" source="n26" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#C8C5B8;" edge="1" parent="1" source="n27" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n28" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell>
