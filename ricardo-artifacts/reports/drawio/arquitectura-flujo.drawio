<mxfile host="app.diagrams.net" type="device">
  <diagram id="Flujo" name="Flujo">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="680" math="0" shadow="0" background="#F4F3EE">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="Un turno de consulta, de micrófono a parlante" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="n3" value="Tiempos medidos el 24-oct-2026 en la A10G. Azul: Meta, en nuestra GPU, lo ajustamos. Verde: Cartesia. Rojo: Claude." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4E4D45;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="950" height="29" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;Micrófono&lt;/b&gt;&lt;br&gt;&lt;br&gt;iPhone o navegador&lt;br&gt;16 kHz mono" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="170" height="76" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;mms-lid-512&lt;/b&gt;&lt;br&gt;&lt;br&gt;¿quechua o castellano?&lt;br&gt;49 ms · 6/6 aciertos&lt;br&gt;No se ajusta: ya acierta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="250" y="160" width="210" height="96" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;Cartesia ink-whisper&lt;/b&gt;&lt;br&gt;&lt;br&gt;Entiende castellano&lt;br&gt;Nube de Cartesia" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B9476;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="510" y="90" width="210" height="76" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;omniASR_LLM_300M&lt;/b&gt;&lt;br&gt;&lt;br&gt;Entiende chanka&lt;br&gt;1.71 s para 15.8 s de audio&lt;br&gt;EL NÚCLEO: esto ajustamos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="510" y="250" width="210" height="96" as="geometry"/></mxCell>
        <mxCell id="n11" value="&lt;b&gt;Claude&lt;/b&gt;&lt;br&gt;&lt;br&gt;Traduce y audita&lt;br&gt;sonnet-5 traduce · haiku-4-5 extrae hechos&lt;br&gt;7–12 s: el cuello de botella&lt;br&gt;Glosario cacheado en el system" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="770" y="160" width="240" height="124" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b&gt;La guarda&lt;/b&gt;&lt;br&gt;&lt;br&gt;Retraduce a ciegas y compara los hechos&lt;br&gt;Si cambió una dosis, no se dice&lt;br&gt;Medido: 0/6 falsos bloqueos, 3/6 fugas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="770" y="320" width="240" height="124" as="geometry"/></mxCell>
        <mxCell id="n16" value="&lt;b&gt;Cartesia Sonic 3.6&lt;/b&gt;&lt;br&gt;&lt;br&gt;Habla castellano · streaming" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B9476;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1070" y="120" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="n17" value="&lt;b&gt;mms-tts-quy&lt;/b&gt;&lt;br&gt;&lt;br&gt;Habla chanka&lt;br&gt;Se ajusta con la voz de la mamá de Freddy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1070" y="230" width="220" height="92" as="geometry"/></mxCell>
        <mxCell id="n20" value="&lt;b&gt;Parlante&lt;/b&gt;&lt;br&gt;&lt;br&gt;Texto primero, audio después:&lt;br&gt;se lee antes de que termine de hablar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1340" y="170" width="210" height="108" as="geometry"/></mxCell>
        <mxCell id="n23" value="&lt;b&gt;Por qué Cartesia no puede hacer el lado quechua&lt;/b&gt;&lt;br&gt;&lt;br&gt;Verificado en su documentación el 24-oct: Sonic 3.6 habla 44 idiomas y el quechua no está entre ellos.&lt;br&gt;Su STT acepta un parámetro `language` en ISO-639-1 con `en` por defecto, y no detecta el idioma solo.&lt;br&gt;Así que el quechua y la detección son nuestros por necesidad, no por preferencia.&lt;br&gt;&lt;br&gt;Y esos 49 ms del detector deciden la arquitectura: siendo tan barato, se detecta primero y se reconoce&lt;br&gt;después, en serie. No hace falta correr los dos reconocedores en paralelo ni adivinar por el turno anterior." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4C2B6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="1250" height="142" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="castellano" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#1B9476;fontColor=#1B9476;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="quechua" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#1F6FD0;fontColor=#1F6FD0;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n7" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n8" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n11" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="a la enfermera" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#1B9476;fontColor=#1B9476;" edge="1" parent="1" source="n14" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="al paciente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#1F6FD0;fontColor=#1F6FD0;" edge="1" parent="1" source="n14" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell>
