<mxfile host="app.diagrams.net" type="device">
  <diagram id="Flow" name="Flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="680" math="0" shadow="0" background="#F4F3EE">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="One turn of a consultation, microphone to speaker" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="n3" value="Times measured 24-Oct-2026 on the A10G. Blue: Meta, on our GPU, fine-tuned by us. Green: Cartesia. Red: Claude." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4E4D45;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="950" height="29" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;Microphone&lt;/b&gt;&lt;br&gt;&lt;br&gt;iPhone or browser&lt;br&gt;16 kHz mono" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="170" height="76" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;mms-lid-512&lt;/b&gt;&lt;br&gt;&lt;br&gt;Quechua or Spanish?&lt;br&gt;49 ms · used as shipped&lt;br&gt;Only 3/6 on real family voice:&lt;br&gt;we never trust it alone" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="250" y="160" width="210" height="124" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;Cartesia ink-whisper&lt;/b&gt;&lt;br&gt;&lt;br&gt;Understands Spanish&lt;br&gt;Cartesia cloud" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B9476;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="510" y="90" width="210" height="76" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;MMS-1B-all + our adapter&lt;/b&gt;&lt;br&gt;&lt;br&gt;Understands Chanka Quechua&lt;br&gt;WER 53.9 % → 40.9 % on a speaker&lt;br&gt;the model never heard&lt;br&gt;THE CORE: this is what we fine-tune" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="510" y="250" width="210" height="140" as="geometry"/></mxCell>
        <mxCell id="n11" value="&lt;b&gt;Claude&lt;/b&gt;&lt;br&gt;&lt;br&gt;Translates and audits&lt;br&gt;Opus 5 decides · Sonnet 5 translates and criticises&lt;br&gt;The slowest step, and on purpose&lt;br&gt;Glossary cached in the system prompt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="770" y="160" width="240" height="140" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b&gt;The guard&lt;/b&gt;&lt;br&gt;&lt;br&gt;Blind back-translation, then facts compared in code&lt;br&gt;If a dose moved, nothing is spoken&lt;br&gt;183/184 seeded errors caught, 2.6 s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="770" y="320" width="240" height="140" as="geometry"/></mxCell>
        <mxCell id="n16" value="&lt;b&gt;Cartesia Sonic 3.6&lt;/b&gt;&lt;br&gt;&lt;br&gt;Speaks Spanish · streaming" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B9476;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1070" y="120" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="n17" value="&lt;b&gt;mms-tts-quy + our fine-tune&lt;/b&gt;&lt;br&gt;&lt;br&gt;Speaks Chanka&lt;br&gt;Trained on Freddy’s mother’s voice,&lt;br&gt;with her permission" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1070" y="230" width="220" height="108" as="geometry"/></mxCell>
        <mxCell id="n20" value="&lt;b&gt;Speaker&lt;/b&gt;&lt;br&gt;&lt;br&gt;Text first, audio after:&lt;br&gt;it can be read before it finishes speaking" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1340" y="170" width="210" height="92" as="geometry"/></mxCell>
        <mxCell id="n23" value="&lt;b&gt;Why Cartesia cannot cover the Quechua side&lt;/b&gt;&lt;br&gt;&lt;br&gt;Checked in their docs on 24-Oct: Sonic 3.6 speaks 44 languages and Quechua is not one of them.&lt;br&gt;Their STT takes a `language` parameter in ISO-639-1, defaults to `en`, and does not detect language itself.&lt;br&gt;So Quechua and the detection are ours out of necessity, not preference.&lt;br&gt;&lt;br&gt;And those 49 ms of detection shape the architecture: being that cheap, we detect first and recognise&lt;br&gt;second, in series. No need to run both recognisers in parallel or guess from the previous turn." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4C2B6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="1250" height="142" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="Spanish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#1B9476;fontColor=#1B9476;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="Quechua" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#1F6FD0;fontColor=#1F6FD0;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n7" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n8" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n11" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="to the nurse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#1B9476;fontColor=#1B9476;" edge="1" parent="1" source="n14" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="to the patient" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#1F6FD0;fontColor=#1F6FD0;" edge="1" parent="1" source="n14" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n16" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n17" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
