<mxfile host="app.diagrams.net" type="device">
  <diagram id="Flujo completo" name="Flujo completo">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1130" math="0" shadow="0" background="#F4F3EE">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="Chaski · un turno completo: oír, entender, revisar y recién ahí hablar" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="n3" value="Azul: Meta en nuestra GPU, ajustado con las voces de la familia · Verde: Cartesia · Rojo: Claude · Morado: barreras en código (el modelo propone, el código decide) · Medido el 24-oct-2026" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4E4D45;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1500" height="29" as="geometry"/></mxCell>
        <mxCell id="n4" value="1 · Oír y entender" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="300" height="31" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Micrófono&lt;/b&gt;&lt;br&gt;&lt;br&gt;iPhone · 16 kHz mono&lt;br&gt;Enfermera o paciente" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="170" height="76" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;mms-lid-512&lt;/b&gt;&lt;br&gt;&lt;br&gt;¿quechua o castellano?&lt;br&gt;49 ms · 6/6 aciertos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="245" y="180" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;Cartesia ink-whisper&lt;/b&gt;&lt;br&gt;&lt;br&gt;Oye castellano&lt;br&gt;3,5 s de audio en 480 ms" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B9476;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="490" y="110" width="230" height="84" as="geometry"/></mxCell>
        <mxCell id="n9" value="&lt;b&gt;MMS-1b + nuestro adaptador&lt;/b&gt;&lt;br&gt;&lt;br&gt;Oye quechua chanka&lt;br&gt;Error 54 % → 41 % con las voces&lt;br&gt;de la familia (hablante nunca oído)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="490" y="250" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="n12" value="&lt;b&gt;B1 · ¿Se oyó bien?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Número, medicamento o parte&lt;br&gt;del cuerpo con baja confianza&lt;br&gt;→ «¿me lo repite?», nunca adivina" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="770" y="175" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;b&gt;Banco de frases verificadas · RAG&lt;/b&gt;&lt;br&gt;&lt;br&gt;216 frases · 24 de emergencia revisadas&lt;br&gt;por la enfermera · embeddings + léxico&lt;br&gt;acierta a la primera 88 % (palabras: 70 %)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1030" y="320" width="290" height="110" as="geometry"/></mxCell>
        <mxCell id="n16" value="&lt;b&gt;INTÉRPRETE · Claude Opus 5&lt;/b&gt;&lt;br&gt;&lt;br&gt;Una llamada decide una de 5 acciones:&lt;br&gt;traducir · repreguntar una vez ·&lt;br&gt;responder al que preguntó · no entendí ·&lt;br&gt;usar frase verificada&lt;br&gt;Pule los dos lados (estilo Wispr Flow)&lt;br&gt;98–100 % acción correcta · 0 datos inventados" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1340" y="140" width="290" height="170" as="geometry"/></mxCell>
        <mxCell id="n19" value="&lt;b&gt;Frase verificada&lt;/b&gt;&lt;br&gt;&lt;br&gt;Audio revisado por la enfermera&lt;br&gt;Va directo al parlante,&lt;br&gt;sin generar ni esperar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1670" y="110" width="200" height="108" as="geometry"/></mxCell>
        <mxCell id="n21" value="2 · Revisar antes de hablar (ante la duda, Chaski no habla)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="455" width="600" height="31" as="geometry"/></mxCell>
        <mxCell id="n22" value="&lt;b&gt;B2 · B3 · El pulido&lt;/b&gt;&lt;br&gt;&lt;br&gt;No cambia ni agrega datos&lt;br&gt;Si cambió algo, se usa&lt;br&gt;lo dicho tal cual" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1620" y="495" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="n24" value="&lt;b&gt;Traductor · Claude Sonnet 5&lt;/b&gt;&lt;br&gt;&lt;br&gt;Esfuerzo medio, empieza mientras decide&lt;br&gt;0/92 términos clave dañados&lt;br&gt;NLLB-1.3B: modo sin conexión" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1340" y="495" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="n26" value="&lt;b&gt;B4 · Términos fijos&lt;/b&gt;&lt;br&gt;&lt;br&gt;Números en chanka (pusaq = 8)&lt;br&gt;medicamento · unidad · negación&lt;br&gt;«con agua» exige unu / yaku" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1060" y="495" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="n28" value="&lt;b&gt;CRÍTICO · Claude Sonnet 5&lt;/b&gt;&lt;br&gt;&lt;br&gt;Retraduce a ciegas (no ve el original)&lt;br&gt;Extrae los hechos de los dos lados&lt;br&gt;Marca consejos o diagnósticos inventados&lt;br&gt;2,6 s · antes 9 s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="740" y="490" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="n30" value="&lt;b&gt;B5 · B6 · El código compara&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dosis · frecuencia · días · unidad&lt;br&gt;negación · con qué se toma&lt;br&gt;concentración · alergia · embarazo&lt;br&gt;Cualquier error → falla cerrada" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="430" y="490" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="n32" value="&lt;b&gt;BLOQUEO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chaski no lo dice y le explica&lt;br&gt;al personal qué dato falló:&lt;br&gt;«no coincidió la frecuencia»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;dashed=1;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="70" y="500" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="n34" value="3 · Hablar" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="300" height="31" as="geometry"/></mxCell>
        <mxCell id="n35" value="&lt;b&gt;Cartesia Sonic 3.6&lt;/b&gt;&lt;br&gt;&lt;br&gt;Habla castellano&lt;br&gt;a la enfermera" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B9476;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="300" y="740" width="220" height="84" as="geometry"/></mxCell>
        <mxCell id="n36" value="&lt;b&gt;mms-tts-quy ajustado&lt;/b&gt;&lt;br&gt;&lt;br&gt;Habla quechua al paciente&lt;br&gt;Con la voz de una enfermera&lt;br&gt;de la comunidad, con su permiso" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="560" y="740" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="n39" value="&lt;b&gt;Parlante y pantalla&lt;/b&gt;&lt;br&gt;&lt;br&gt;Texto primero, audio después&lt;br&gt;Rojo solo si Chaski no lo dijo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="440" y="880" width="240" height="76" as="geometry"/></mxCell>
        <mxCell id="n42" value="&lt;b&gt;Al cerrar la consulta · Claude&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nota clínica para el personal&lt;br&gt;Indicaciones para llevar al paciente&lt;br&gt;Palabras quechua nuevas de esa consulta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1150" y="740" width="260" height="124" as="geometry"/></mxCell>
        <mxCell id="n43" value="&lt;b&gt;Receta · Claude visión&lt;/b&gt;&lt;br&gt;&lt;br&gt;Foto de la caja o la receta&lt;br&gt;→ dosis, frecuencia, días&lt;br&gt;→ las mismas barreras → «¿me lo repite?»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1450" y="740" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="n44" value="&lt;b&gt;Lo medido&lt;/b&gt;&lt;br&gt;&lt;br&gt;Banco de 952 errores sembrados (dosis cambiada, negación invertida, medicamento, unidad, «con agua» perdido, consejo inventado): Chaski atrapó 183 de 184 y el 100 % de los críticos, y cada bloqueo dice qué dato falló.&lt;br&gt;Preguntarle a Claude «¿está bien traducido?» también atrapa, pero no dice por qué y retiene 1 de cada 4 frases correctas.&lt;br&gt;Turno completo medido de punta a punta: instrucción traducida ~17 s (oír 1,1 · decidir 2,9 · traducir 9,0 · crítico 3,1 · voz 1,0); repregunta o frase verificada ~4 s. Solo dos roles de Claude (intérprete y crítico): ningún agente de más." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4C2B6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="1830" height="110" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="castellano" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#1B9476;fontColor=#1B9476;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="quechua" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#1F6FD0;fontColor=#1F6FD0;" edge="1" parent="1" source="n6" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n8" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n9" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n12" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="candidatas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="usar frase" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#8A4FBD;fontColor=#8A4FBD;" edge="1" parent="1" source="n16" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" value="traducir" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#C8372F;fontColor=#C8372F;" edge="1" parent="1" source="n16" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n22" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n24" target="n26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n26" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n28" target="n30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e33" value="no coincide" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#C8372F;fontColor=#C8372F;" edge="1" parent="1" source="n30" target="n32"><mxGeometry relative="1" as="geometry"/></mxCell>
