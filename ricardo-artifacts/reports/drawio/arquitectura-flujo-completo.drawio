<mxfile host="app.diagrams.net" type="device">
  <diagram id="Full flow" name="Full flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1130" math="0" shadow="0" background="#F4F3EE">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="Chaski · one full turn: hear, understand, check, and only then speak" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="n3" value="Blue: Meta on our GPU, fine-tuned on the families’ voices · Green: Cartesia · Red: Claude · Purple: guards in code (the model proposes, the code decides) · Measured 24/25-Oct-2026" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4E4D45;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1500" height="29" as="geometry"/></mxCell>
        <mxCell id="n4" value="1 · Hear and understand" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="300" height="31" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Microphone&lt;/b&gt;&lt;br&gt;&lt;br&gt;iPhone · 16 kHz mono&lt;br&gt;Nurse or patient" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="170" height="76" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;mms-lid-512&lt;/b&gt;&lt;br&gt;&lt;br&gt;Quechua or Spanish?&lt;br&gt;49 ms · 3/6 on real family voice,&lt;br&gt;so it never decides alone" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="245" y="180" width="200" height="108" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;Cartesia ink-whisper&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hears Spanish&lt;br&gt;3.5 s of audio in 480 ms" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B9476;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="490" y="110" width="230" height="84" as="geometry"/></mxCell>
        <mxCell id="n9" value="&lt;b&gt;MMS-1B-all + our adapter&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hears Chanka Quechua&lt;br&gt;WER 53.9 % → 40.9 % with the families’&lt;br&gt;voices (held-out speaker)&lt;br&gt;2.2 M of 965 M parameters trained" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="490" y="250" width="250" height="124" as="geometry"/></mxCell>
        <mxCell id="n12" value="&lt;b&gt;B1 · Was it heard right?&lt;/b&gt;&lt;br&gt;&lt;br&gt;A number, drug or body part&lt;br&gt;heard with low confidence&lt;br&gt;→ asks again, never guesses" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="770" y="175" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="n15" value="&lt;b&gt;Verified phrase bank · RAG&lt;/b&gt;&lt;br&gt;&lt;br&gt;216 phrases · 24 emergency ones reviewed&lt;br&gt;by the nurse · embeddings + lexical&lt;br&gt;top-1 88 % (words alone: 70 %)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1030" y="320" width="290" height="110" as="geometry"/></mxCell>
        <mxCell id="n16" value="&lt;b&gt;INTERPRETER · Claude Opus 5&lt;/b&gt;&lt;br&gt;&lt;br&gt;One call picks one of 5 actions:&lt;br&gt;translate · ask back once ·&lt;br&gt;answer the asker · did not understand ·&lt;br&gt;use a verified phrase&lt;br&gt;Cleans up both sides before anything is said&lt;br&gt;98–100 % correct action · 0 invented clinical facts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1340" y="140" width="290" height="172" as="geometry"/></mxCell>
        <mxCell id="n19" value="&lt;b&gt;Verified phrase&lt;/b&gt;&lt;br&gt;&lt;br&gt;Audio reviewed by the nurse&lt;br&gt;Goes straight to the speaker:&lt;br&gt;nothing generated, nothing waited for" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1670" y="110" width="200" height="140" as="geometry"/></mxCell>
        <mxCell id="n21" value="2 · Check before speaking (in doubt, Chaski stays quiet)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="455" width="600" height="31" as="geometry"/></mxCell>
        <mxCell id="n22" value="&lt;b&gt;B2 · B3 · The clean-up&lt;/b&gt;&lt;br&gt;&lt;br&gt;May not change or add any fact&lt;br&gt;If it did, the raw sentence&lt;br&gt;is used instead" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1620" y="495" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="n24" value="&lt;b&gt;Translator · Claude Sonnet 5&lt;/b&gt;&lt;br&gt;&lt;br&gt;Medium effort, starts while Opus decides&lt;br&gt;0 of 92 fixed terms damaged (NLLB: 3)&lt;br&gt;NLLB-1.3B stays as the offline mode" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1340" y="495" width="240" height="140" as="geometry"/></mxCell>
        <mxCell id="n26" value="&lt;b&gt;B4 · Fixed terms&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chanka numerals (pusaq = 8)&lt;br&gt;drug · unit · negation&lt;br&gt;“with water” must carry unu / yaku" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1060" y="495" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="n28" value="&lt;b&gt;CRITIC · Claude Sonnet 5&lt;/b&gt;&lt;br&gt;&lt;br&gt;Back-translates blind (never sees the original)&lt;br&gt;Extracts the facts from both sides&lt;br&gt;Flags invented advice or diagnoses&lt;br&gt;2.6 s · was 9 s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="740" y="490" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="n30" value="&lt;b&gt;B5 · B6 · Code does the comparing&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dose · frequency · days · unit&lt;br&gt;negation · what to take it with&lt;br&gt;strength · allergy · pregnancy&lt;br&gt;Any mismatch → fails closed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="430" y="490" width="270" height="130" as="geometry"/></mxCell>
        <mxCell id="n32" value="&lt;b&gt;BLOCKED&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chaski says nothing and tells&lt;br&gt;the staff which fact failed:&lt;br&gt;“the frequency did not match”" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;dashed=1;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="70" y="500" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="n34" value="3 · Speak" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="300" height="31" as="geometry"/></mxCell>
        <mxCell id="n35" value="&lt;b&gt;Cartesia Sonic 3.6&lt;/b&gt;&lt;br&gt;&lt;br&gt;Speaks Spanish&lt;br&gt;to the nurse" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B9476;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="300" y="740" width="220" height="84" as="geometry"/></mxCell>
        <mxCell id="n36" value="&lt;b&gt;mms-tts-quy, fine-tuned&lt;/b&gt;&lt;br&gt;&lt;br&gt;Speaks Quechua to the patient&lt;br&gt;In the voice of a woman from the&lt;br&gt;community, with her permission" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;strokeWidth=3;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="560" y="740" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="n39" value="&lt;b&gt;Speaker and screen&lt;/b&gt;&lt;br&gt;&lt;br&gt;Text first, audio after&lt;br&gt;Red only when Chaski did not say it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="440" y="880" width="240" height="92" as="geometry"/></mxCell>
        <mxCell id="n42" value="&lt;b&gt;When the visit ends · Claude&lt;/b&gt;&lt;br&gt;&lt;br&gt;A clinical note for the staff&lt;br&gt;Take-home instructions for the patient&lt;br&gt;New Quechua words from that visit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1150" y="740" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="n43" value="&lt;b&gt;Prescription · Claude vision&lt;/b&gt;&lt;br&gt;&lt;br&gt;Photo of the box or the script&lt;br&gt;→ dose, frequency, days&lt;br&gt;→ the same guards → asks again if unsure" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1450" y="740" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="n44" value="&lt;b&gt;What was measured&lt;/b&gt;&lt;br&gt;&lt;br&gt;A bank of 952 seeded errors (changed dose, flipped negation, wrong drug, wrong unit, dropped “with water”, invented advice): Chaski caught 183 of 184 and 100 % of the critical ones, and every block names the fact that failed.&lt;br&gt;Asking Claude “is this translated correctly?” also catches errors, but never says why and holds back 1 in 4 correct sentences.&lt;br&gt;Full turn, end to end, live: p50 7.8 s, p95 11.4 s; a whole consultation 49–70 s; $0.0084 per turn. Only two Claude roles (interpreter and critic): no agent for its own sake." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4C2B6;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="1830" height="110" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="Spanish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#1B9476;fontColor=#1B9476;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="Quechua" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#1F6FD0;fontColor=#1F6FD0;" edge="1" parent="1" source="n6" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n8" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n9" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n12" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="candidates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="use phrase" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#8A4FBD;fontColor=#8A4FBD;" edge="1" parent="1" source="n16" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" value="translate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#C8372F;fontColor=#C8372F;" edge="1" parent="1" source="n16" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n22" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n24" target="n26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n26" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n28" target="n30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e33" value="mismatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#C8372F;fontColor=#C8372F;" edge="1" parent="1" source="n30" target="n32"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e37" value="passes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#1B9476;fontColor=#1B9476;" edge="1" parent="1" source="n30" target="n35"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e38" value="passes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#1F6FD0;fontColor=#1F6FD0;" edge="1" parent="1" source="n30" target="n36"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n35" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n36" target="n39"><mxGeometry relative="1" as="geometry"/></mxCell>
