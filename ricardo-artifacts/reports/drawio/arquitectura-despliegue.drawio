        <mxCell id="n2" value="Chaski — where each piece runs" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="620" height="40" as="geometry"/></mxCell>
        <mxCell id="n3" value="Deployment architecture · 24-Oct-2026 18:00 UTC · no laptop in the chain any more" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4E4D45;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="950" height="29" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;Chaski app (Freddy)&lt;/b&gt;&lt;br&gt;&lt;br&gt;iOS · calls the public URL&lt;br&gt;Nothing changed on its side" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/png,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="200" height="108" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;br&gt;GET /flujo · demo and testing" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="200" height="76" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;Labelling UI /corregir&lt;/b&gt;&lt;br&gt;&lt;br&gt;Still on the laptop: reads local audio.&lt;br&gt;Opens its own SSH tunnel." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;dashed=1;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="40" y="298" width="200" height="92" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;ngrok · HTTPS edge&lt;/b&gt;&lt;br&gt;&lt;br&gt;unsubmitted-wally-relatable&lt;br&gt;.ngrok-free.dev&lt;br&gt;&lt;br&gt;Reserved domain: survives&lt;br&gt;every restart" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A5A52;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="210" height="140" as="geometry"/></mxCell>
        <mxCell id="n10" value="EC2 g5.xlarge · 44.220.107.99 · NVIDIA A10G 23 GB" style="rounded=0;html=1;fillColor=#FAF9F5;strokeColor=#8A4FBD;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#8A4FBD;" vertex="1" parent="1"><mxGeometry x="550" y="92" width="450" height="560" as="geometry"/></mxCell>
        <mxCell id="n11" value="" style="rounded=0;html=1;fillColor=none;strokeColor=none;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="930" y="100" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="n12" value="&lt;b&gt;ngrok agent&lt;/b&gt;&lt;br&gt;&lt;br&gt;Runs in here, not on the laptop" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A5A52;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="578" y="150" width="320" height="60" as="geometry"/></mxCell>
        <mxCell id="n13" value="&lt;b&gt;Orchestrator · port 8080&lt;/b&gt;&lt;br&gt;&lt;br&gt;servicio/app.py · FastAPI&lt;br&gt;/turno/paciente · /turno/enfermera · /ver · /escuchar&lt;br&gt;own venv: fastapi · anthropic · httpx&lt;br&gt;&lt;br&gt;venv kept SEPARATE from the models, on purpose" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="578" y="228" width="394" height="130" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b&gt;Speech service · port 8000&lt;/b&gt;&lt;br&gt;&lt;br&gt;instancia.py · the Meta models, on the GPU&lt;br&gt;MMS-1B-all + adapter · mms-lid-512 · mms-tts-quy&lt;br&gt;torch==2.8.0 · fairseq2 · numpy~=1.23 — pinned&lt;br&gt;One pip install on top breaks it. It happened once.&lt;br&gt;LID 49 ms · ASR 1.71 s for 15.8 s · peak 3.41 GB of 23" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="578" y="404" width="394" height="136" as="geometry"/></mxCell>
        <mxCell id="n17" value="&lt;b&gt;/ · 145 GB&lt;/b&gt;&lt;br&gt;90 % full&lt;br&gt;Put nothing here&lt;br&gt;Survives a stop" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;fontSize=10;fontColor=#4E4D45;align=center;" vertex="1" parent="1"><mxGeometry x="578" y="556" width="180" height="86" as="geometry"/></mxCell>
        <mxCell id="n18" value="&lt;b&gt;/opt/dlami/nvme&lt;/b&gt;&lt;br&gt;229 GB · 9 %&lt;br&gt;Everything lives here&lt;br&gt;EPHEMERAL: wiped on stop" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#1B9476;strokeWidth=2;fontSize=10;fontColor=#4E4D45;align=center;" vertex="1" parent="1"><mxGeometry x="792" y="556" width="180" height="86" as="geometry"/></mxCell>
        <mxCell id="n19" value="&lt;b&gt;Anthropic API&lt;/b&gt;&lt;br&gt;&lt;br&gt;decide · translate · criticise · read boxes&lt;br&gt;opus-5 · sonnet-5 · haiku-4-5&lt;br&gt;&lt;br&gt;The slowest step of a turn, and the one we refuse to cut" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1050" y="228" width="220" height="156" as="geometry"/></mxCell>
        <mxCell id="n20" value="&lt;b&gt;Cartesia API&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sonic 3.6 · speaks Spanish&lt;br&gt;ink-whisper · understands it&lt;br&gt;&lt;br&gt;No Quechua: that is why Quechua is ours" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B9476;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;shape=label;image=data:image/svg+xml,;imageWidth=26;imageHeight=26;imageAlign=left;imageVerticalAlign=top;spacingLeft=42;" vertex="1" parent="1"><mxGeometry x="1050" y="404" width="220" height="136" as="geometry"/></mxCell>
        <mxCell id="n23" value="&lt;b&gt;What changed&lt;/b&gt;&lt;br&gt;&lt;br&gt;Before: app → ngrok → a laptop → SSH tunnel →&lt;br&gt;instance, and all the way back again.&lt;br&gt;Closing the laptop took it down.&lt;br&gt;&lt;br&gt;Now the patient’s audio never leaves the instance.&lt;br&gt;Same URL, so the app did not change a line.&lt;br&gt;&lt;br&gt;Deployed with `bash servicio/desplegar.sh`, re-runnable.&lt;br&gt;Keys go over stdin into .env, chmod 600; never through git." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="40" y="412" width="470" height="189" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n4" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;" edge="1" parent="1" source="n7" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="127.0.0.1&lt;br&gt;never leaves the box" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#8A4FBD;strokeWidth=3;fontColor=#8A4FBD;fontStyle=1;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell>
