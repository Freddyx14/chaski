        <mxCell id="n2" value="Chaski — dónde corre cada cosa" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontColor=#16160F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="620" height="40" as="geometry"/></mxCell>
        <mxCell id="n3" value="Arquitectura de despliegue · 24-oct-2026 18:00 UTC · desde hoy la laptop de Ricardo ya no está en la cadena" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4E4D45;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="950" height="29" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;App de Chaski (Freddy)&lt;/b&gt;&lt;br&gt;&lt;br&gt;iOS · consume la URL pública&lt;br&gt;No cambió nada el 24-oct" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="200" height="84" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Navegador&lt;/b&gt;&lt;br&gt;&lt;br&gt;GET /flujo · demo y pruebas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="200" height="64" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;Etiquetador /corregir&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sigue en la laptop: lee audio local.&lt;br&gt;Abre su propio túnel SSH." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C7A;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="298" width="200" height="92" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;ngrok · borde HTTPS&lt;/b&gt;&lt;br&gt;&lt;br&gt;unsubmitted-wally-relatable&lt;br&gt;.ngrok-free.dev&lt;br&gt;&lt;br&gt;Dominio reservado: no cambia&lt;br&gt;entre reinicios" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A5A52;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="210" height="140" as="geometry"/></mxCell>
        <mxCell id="n10" value="Instancia EC2 g5.xlarge · 44.220.107.99 · NVIDIA A10G 23 GB" style="rounded=0;html=1;fillColor=#FAF9F5;strokeColor=#8A4FBD;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#8A4FBD;" vertex="1" parent="1"><mxGeometry x="550" y="92" width="450" height="560" as="geometry"/></mxCell>
        <mxCell id="n11" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;gradientDirection=north;fillColor=#D05C17;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1"><mxGeometry x="930" y="100" width="52" height="52" as="geometry"/></mxCell>
        <mxCell id="n12" value="&lt;b&gt;Agente de ngrok&lt;/b&gt;&lt;br&gt;&lt;br&gt;Corre aquí dentro, no en la laptop" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A5A52;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="578" y="150" width="320" height="60" as="geometry"/></mxCell>
        <mxCell id="n13" value="&lt;b&gt;Orquestador · puerto 8080&lt;/b&gt;&lt;br&gt;&lt;br&gt;servicio/app.py · FastAPI&lt;br&gt;/turno/paciente · /turno/enfermera · /ver · /escuchar&lt;br&gt;venv propio: fastapi · anthropic · httpx&lt;br&gt;&lt;br&gt;venv SEPARADO del de los modelos, a propósito" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="578" y="228" width="394" height="130" as="geometry"/></mxCell>
        <mxCell id="n14" value="&lt;b&gt;Servicio de voz · puerto 8000&lt;/b&gt;&lt;br&gt;&lt;br&gt;instancia.py · los tres modelos de Meta en GPU&lt;br&gt;omniASR_LLM_300M · mms-lid-512 · mms-tts-quy&lt;br&gt;torch==2.8.0 · fairseq2 · numpy~=1.23 — clavados&lt;br&gt;Un pip install encima lo rompe. Ya pasó una vez.&lt;br&gt;LID 49 ms · ASR 1.71 s para 15.8 s · pico 3.41 GB de 23" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FD0;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="578" y="404" width="394" height="136" as="geometry"/></mxCell>
        <mxCell id="n17" value="&lt;b&gt;/ · 145 GB&lt;/b&gt;&lt;br&gt;90 % lleno&lt;br&gt;No poner nada aquí&lt;br&gt;Persiste al parar" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;fontSize=10;fontColor=#4E4D45;align=center;" vertex="1" parent="1"><mxGeometry x="578" y="556" width="180" height="86" as="geometry"/></mxCell>
        <mxCell id="n18" value="&lt;b&gt;/opt/dlami/nvme&lt;/b&gt;&lt;br&gt;229 GB · 9 %&lt;br&gt;Todo vive aquí&lt;br&gt;EFÍMERO: se borra al parar" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#1B9476;strokeWidth=2;fontSize=10;fontColor=#4E4D45;align=center;" vertex="1" parent="1"><mxGeometry x="792" y="556" width="180" height="86" as="geometry"/></mxCell>
        <mxCell id="n19" value="&lt;b&gt;API de Anthropic&lt;/b&gt;&lt;br&gt;&lt;br&gt;traducir · auditar · leer cajas&lt;br&gt;sonnet-5 · haiku-4-5&lt;br&gt;&lt;br&gt;7–12 s por turno: el cuello de botella real" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C8372F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="1050" y="228" width="220" height="130" as="geometry"/></mxCell>
        <mxCell id="n20" value="&lt;b&gt;API de Cartesia&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sonic 3.6 · habla castellano&lt;br&gt;ink-whisper · lo entiende&lt;br&gt;&lt;br&gt;Sin quechua: por eso el quechua es nuestro" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B9476;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="1050" y="404" width="220" height="136" as="geometry"/></mxCell>
        <mxCell id="n23" value="&lt;b&gt;Lo que cambió hoy&lt;/b&gt;&lt;br&gt;&lt;br&gt;Antes: app → ngrok → laptop de Ricardo → túnel SSH →&lt;br&gt;instancia, y todo de vuelta por el mismo camino.&lt;br&gt;Si cerraba la laptop, se caía.&lt;br&gt;&lt;br&gt;Ahora el audio del paciente no sale de la instancia.&lt;br&gt;La URL es la misma: Freddy no cambia una línea.&lt;br&gt;&lt;br&gt;Se despliega con `bash servicio/desplegar.sh`, re-ejecutable.&lt;br&gt;Las claves viajan por stdin a .env con chmod 600; nunca por git." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A4FBD;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#4E4D45;" vertex="1" parent="1"><mxGeometry x="40" y="412" width="470" height="189" as="geometry"/></mxCell>
