        <mxCell id="e16" value="127.0.0.1&lt;br&gt;no sale a internet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#8C8C7A;strokeWidth=2;fontSize=11;fontColor=#4E4D45;strokeColor=#8A4FBD;strokeWidth=3;fontColor=#8A4FBD;fontStyle=1;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell>
