{
  "expo": {
    "name": "Rimay",
    "slug": "rimay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rimay",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "lat.loopmind.rimay",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Rimay escucha la consulta para interpretarla entre castellano y quechua.",
        "NSCameraUsageDescription": "Rimay lee la receta o la caja del medicamento.",
        "NSPhotoLibraryUsageDescription": "Rimay lee la foto de una receta o de una caja.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F4F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Rimay escucha la consulta para interpretarla entre castellano y quechua."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Rimay lee la receta o la caja del medicamento.",
          "photosPermission": "Rimay lee la foto de una receta o de una caja."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}